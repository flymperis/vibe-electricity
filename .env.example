# Copy to .env and adjust. The values marked (UI) can also be changed later on the Settings page.

# Paperless-ngx API, as seen from this app (container name on the same podman/docker network,
# or http://<server>:8000), and a token (Paperless: profile > API token; read access is enough).
PAPERLESS_URL=http://paperless-webserver:8000
PAPERLESS_TOKEN=
# The address your browser uses for Paperless (links to the documents). Empty = PAPERLESS_URL.
PAPERLESS_PUBLIC_URL=
# (UI) Documents with this tag are electricity bills.
PAPERLESS_TAG=Electricity

# (UI) Ollama, used only for bills the built-in rules cannot read (other suppliers / new layouts).
# Ollama container on the same network: http://ollama:11434
# Ollama on the host:                   http://host.containers.internal:11434 (podman)
#                                        http://host.docker.internal:11434    (docker)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
LLM_ENABLED=true

# (UI) Fallback poll of Paperless; new bills arrive instantly through the webhook.
SYNC_INTERVAL_MINUTES=30
# If set, POST /api/webhook needs the header X-Webhook-Secret with this value.
WEBHOOK_SECRET=
TIMEZONE=Europe/Athens
